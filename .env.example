# Copy this file to .env and fill in your values. Never commit .env.

# API key for a hosted Qwen API. Leave empty for a local Ollama / vLLM server.
QWEN_API_KEY=

# OpenAI-compatible base URL. Default is a local Ollama server.
QWEN_BASE_URL=http://localhost:11434/v1

# Model name as your server or provider knows it.
QWEN_MODEL=qwen3-vl:8b
