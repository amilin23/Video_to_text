# Copy this file to .env and fill in your values. Never commit .env.
# All other settings live in settings.py.

# API key for a hosted Qwen API. Leave empty for a local Ollama / vLLM server.
QWEN_API_KEY=

# Server address and model name. Used when BASE_URL / MODEL are None in settings.py.
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_MODEL=qwen3-vl:8b

# ElevenLabs key, for voice questions (press V in live mode).
ELEVENLABS_API_KEY=
