# Copy this file to .env and fill in values. Never commit .env.

# API key for a hosted Qwen API.
QWEN_API_KEY= 

# OpenAI-compatible base URL.
QWEN_BASE_URL= 

# Model name as server or provider knows it.
QWEN_MODEL=  

# ElevenLabs key, for voice questions (press V in live mode).
ELEVENLABS_API_KEY= 
VOICE_ID=


